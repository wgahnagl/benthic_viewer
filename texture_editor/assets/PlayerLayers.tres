[sub_resource type="Shader" id="Shader_4nhb6"]
resource_local_to_scene = true
code = "shader_type spatial;
render_mode depth_draw_opaque, cull_back;

uniform sampler2D base_texture;
uniform sampler2D pattern_texture;
uniform sampler2D face_texture;

void fragment() {
	vec4 base = texture(base_texture, UV);
	vec4 pattern = texture(pattern_texture, UV);
	vec4 face = texture(face_texture, UV);
	vec4 final = base;
	if (pattern.a > 0.5) {
		final = pattern;
	}
	if (face.a > 0.5) {
		final = face;
	}
	ALBEDO = final.rgb;
}"
script = SubResource("GDScript_ysuoj")

