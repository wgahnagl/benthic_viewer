[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://../texture_editor_rs/target/debug/libtexture_editor_rs.so"
linux.release.x86_64 =   "res://../texture_editor_rs/target/release/libtexture_editor_rs.so"
windows.debug.x86_64 =   "res://../texture_editor_rs/target/debug/texture_editor_rs.dll"
windows.release.x86_64 = "res://../texture_editor_rs/target/release/texture_editor_rs.dll"
macos.debug =            "res://../texture_editor_rs/target/debug/libtexture_editor_rs.dylib"
macos.release =          "res://../texture_editor_rs/target/release/libtexture_editor_rs.dylib"
macos.debug.arm64 =      "res://../texture_editor_rs/target/debug/libtexture_editor_rs.dylib"
macos.release.arm64 =    "res://../texture_editor_rs/target/release/libtexture_editor_rs.dylib"
