[gd_scene load_steps=2 format=3 uid="uid://dau8qtyic5qof"]

[sub_resource type="GDScript" id="GDScript_3q3xb"]
script/source = "extends Control
@onready var metaverse_session = get_tree().root.get_node(\"MetaverseSession\") 

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	metaverse_session.connect(\"login_response\", _on_login_response)

func _on_login_response(success, message):
	if success == \"Success\":
		get_tree().change_scene_to_file(\"res://chat.tscn\")
	else:
		print(\"Login failed! Returning to login screen...\")
		get_tree().change_scene_to_file(\"res://login.tscn\")
"

